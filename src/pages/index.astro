---
import BaseLayout from '../layouts/BaseLayout.astro';
import SyzygyAlignment from '../components/islands/SyzygyAlignment.tsx';
import services from '../data/services.json';
import projects from '../data/projects.json';
---

<BaseLayout 
  title="Syzygy — Agencia Digital: Experiencia, Identidad y Contenido"
  description="Estudio de diseño y desarrollo web de alto estándar. Alineamos los tres ejes fundamentales de una marca: Experiencia Web (UX), Identidad Visual (Storytelling) y Contenido Multimedia (Marketing)."
>
  <!-- HERO SECTION -->
  <section class="relative pt-20 pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-cyan-300">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
        <span>Alineación Astronómica de Marcas</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400">Headless Architecture</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] font-['Space_Grotesk']">
        La perfecta alineación entre <br class="hidden sm:inline" />
        <span class="text-gradient-syzygy">Código, Identidad & Contenido.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed font-light">
        Una marca solo trasciende cuando sus tres cuerpos fundamentales gravitan en sincronía: la 
        <strong class="text-cyan-300 font-semibold"> Experiencia</strong> en código limpio, la 
        <strong class="text-purple-300 font-semibold"> Identidad</strong> con narrativa potente y el 
        <strong class="text-rose-300 font-semibold"> Contenido</strong> multimedia de alto impacto.
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href="#ejes" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-sm bg-gradient-to-r from-cyan-500 via-purple-600 to-rose-500 text-white shadow-lg shadow-purple-500/25 hover:shadow-cyan-500/35 transition-all duration-300 hover:scale-[1.02] active:scale-95"
        >
          Explorar los 3 Ejes
        </a>
        <a 
          href="#proyectos" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-sm bg-slate-900 border border-white/10 text-slate-200 hover:bg-slate-800 hover:border-white/20 transition-all duration-300"
        >
          Ver Casos de Estudio
        </a>
      </div>

      <!-- Value Props Micro-Bar -->
      <div class="pt-12 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto border-t border-white/5">
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold text-white font-mono">100/100</div>
          <div class="text-xs text-slate-400">Core Web Vitals</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold text-white font-mono">0% Bloat</div>
          <div class="text-xs text-slate-400">Código Puro SSG</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold text-white font-mono">Por Sprints</div>
          <div class="text-xs text-slate-400">Plazos y Metas Claras</div>
        </div>
        <div class="text-center">
          <div class="text-xl sm:text-2xl font-bold text-white font-mono">Headless</div>
          <div class="text-xs text-slate-400">WP Backend + Astro</div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE ISLAND SECTION: THE SYZYGY ORBIT -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <SyzygyAlignment client:load />
  </section>

  <!-- LOS 3 EJES DETALLADOS -->
  <section id="ejes" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">Metodología Central</span>
      <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight font-['Space_Grotesk']">
        Los Tres Cuerpos Fundamentales
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Cada eje resuelve un dolor crítico de la presencia de marca contemporánea. Ninguno opera de forma aislada.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div 
          class="glass-panel rounded-2xl p-8 flex flex-col justify-between relative overflow-hidden group"
          style={{ borderColor: service.borderClass }}
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-slate-500">0{index + 1} // EJECUTIVO</span>
              <span 
                class="w-3 h-3 rounded-full" 
                style={{ backgroundColor: service.color, boxShadow: `0 0 15px ${service.color}` }}
              ></span>
            </div>

            <h3 class="text-2xl font-extrabold text-white tracking-tight">
              {service.axis}
            </h3>

            <p class="text-xs font-mono text-slate-400">
              {service.subheading}
            </p>

            <p class="text-sm text-slate-300 leading-relaxed">
              {service.description}
            </p>

            <div class="pt-4 border-t border-white/5 space-y-2">
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block">Entregables:</span>
              <ul class="space-y-1.5">
                {service.deliverables.map((item) => (
                  <li class="text-xs text-slate-300 flex items-start gap-2">
                    <span style={{ color: service.color }}>▹</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-white/5 flex items-center justify-between">
            <span class="text-xs text-slate-400 font-mono">Sprint Definido</span>
            <span class="text-xs font-semibold" style={{ color: service.color }}>
              Ver detalles →
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CASOS DE ESTUDIO / PORTFOLIO -->
  <section id="proyectos" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/5">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-3 max-w-2xl">
        <span class="text-xs font-mono uppercase tracking-widest text-purple-400">Casos Recientes</span>
        <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight font-['Space_Grotesk']">
          Sincronía en Acción
        </h2>
        <p class="text-slate-400 text-sm">
          Proyectos donde la experiencia web, la identidad y el contenido se fusionaron con objetivos tangibles.
        </p>
      </div>

      <div class="text-xs font-mono text-slate-400 bg-white/5 px-4 py-2 rounded-xl border border-white/10 self-start md:self-auto">
        Mock local sincronizado con schema WP CPT
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {projects.map((proj) => (
        <article class="glass-panel rounded-2xl overflow-hidden flex flex-col justify-between group hover:border-cyan-500/40">
          <div class="p-6 sm:p-8 space-y-4">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              {proj.axes.map((ax) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">
                  {ax}
                </span>
              ))}
              <span class="text-[10px] font-mono ml-auto text-slate-500">{proj.year}</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
              {proj.title}
            </h3>

            <p class="text-xs text-slate-400 font-mono">
              Cliente: {proj.client} • {proj.category}
            </p>

            <p class="text-sm text-slate-300 leading-relaxed">
              {proj.excerpt}
            </p>

            <!-- Stats Badge -->
            <div class="grid grid-cols-2 gap-2 pt-3">
              {proj.stats.map((s) => (
                <div class="bg-black/40 p-2.5 rounded-lg border border-white/5">
                  <div class="text-xs text-slate-400">{s.label}</div>
                  <div class="text-sm font-bold text-cyan-400 font-mono">{s.value}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="p-6 sm:p-8 pt-0 flex flex-wrap gap-1.5">
            {proj.tags.map((t) => (
              <span class="text-[10px] font-mono bg-slate-900/80 px-2 py-0.5 rounded text-slate-400 border border-white/5">
                #{t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- METODOLOGÍA: POR PROYECTOS Y PLAZOS DEFINIDOS -->
  <section id="metodologia" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/5">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 relative overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-mono uppercase tracking-widest text-rose-400">Filosofía de Operación</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-['Space_Grotesk']">
            Por Proyectos y Plazos Concretos. <br />
            <span class="text-slate-400 font-normal">Sin planes redundantes.</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            En Syzygy evitamos los esquemas de retención mensual tradicionales que diluyen el foco. Preferimos involucrarnos profundamente en proyectos de alto valor con alcance claro, fecha de entrega y criterios de éxito medibles.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-slate-900/60 border border-white/5">
              <div class="text-sm font-bold text-white mb-1">01. Alcance Cerrado</div>
              <p class="text-xs text-slate-400">Presupuestos transparentes sin costos ocultos ni facturas interminables.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-900/60 border border-white/5">
              <div class="text-sm font-bold text-white mb-1">02. Foco Multidisciplinar</div>
              <p class="text-xs text-slate-400">El equipo completo se alinea en tu sprint: UX, diseño y producción de contenido.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-black/60 p-6 sm:p-8 rounded-2xl border border-white/10 space-y-4">
          <h3 class="text-base font-bold text-white font-mono">El Manifiesto de Entrega</h3>
          <ul class="space-y-3 text-xs text-slate-300">
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">✔</span>
              <span>Entregables testeados en producción</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">✔</span>
              <span>Propiedad total del código y los activos</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">✔</span>
              <span>Documentación modular para autogestión</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">✔</span>
              <span>Garantía de rendimiento Lighthouse 100/100</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULARIO DE INICIO DE PROYECTO -->
  <section id="contacto" class="py-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto border-t border-white/5 text-center">
    <div class="space-y-4 mb-12">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">Inicia la Conversación</span>
      <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight font-['Space_Grotesk']">
        ¿Alineamos tu Marca?
      </h2>
      <p class="text-slate-400 text-sm max-w-lg mx-auto">
        Cuéntanos sobre tu proyecto, qué ejes necesitas abordar y definamos juntos un sprint de trabajo.
      </p>
    </div>

    <form class="glass-panel p-8 sm:p-10 rounded-3xl text-left space-y-6" onsubmit="event.preventDefault(); alert('Brief recibido preliminarmente.');">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label class="text-xs font-mono uppercase tracking-wider text-slate-300 block">Tu Nombre</label>
          <input 
            type="text" 
            placeholder="Ej. Constanza Silva" 
            required
            class="w-full bg-slate-900/80 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400 transition-colors placeholder:text-slate-600"
          />
        </div>
        <div class="space-y-2">
          <label class="text-xs font-mono uppercase tracking-wider text-slate-300 block">Correo Electrónico</label>
          <input 
            type="email" 
            placeholder="nombre@empresa.com" 
            required
            class="w-full bg-slate-900/80 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400 transition-colors placeholder:text-slate-600"
          />
        </div>
      </div>

      <div class="space-y-2">
        <label class="text-xs font-mono uppercase tracking-wider text-slate-300 block">Ejes Requeridos</label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <label class="flex items-center gap-2 bg-slate-900/60 p-3 rounded-xl border border-white/10 cursor-pointer hover:border-cyan-500/40 text-xs text-slate-300">
            <input type="checkbox" name="axes" value="experiencia" class="accent-cyan-400" checked />
            <span>Experiencia (Web/UX)</span>
          </label>
          <label class="flex items-center gap-2 bg-slate-900/60 p-3 rounded-xl border border-white/10 cursor-pointer hover:border-purple-500/40 text-xs text-slate-300">
            <input type="checkbox" name="axes" value="identidad" class="accent-purple-400" />
            <span>Identidad (Branding)</span>
          </label>
          <label class="flex items-center gap-2 bg-slate-900/60 p-3 rounded-xl border border-white/10 cursor-pointer hover:border-rose-500/40 text-xs text-slate-300">
            <input type="checkbox" name="axes" value="contenido" class="accent-rose-400" />
            <span>Contenido (Marketing)</span>
          </label>
        </div>
      </div>

      <div class="space-y-2">
        <label class="text-xs font-mono uppercase tracking-wider text-slate-300 block">Detalles del Proyecto / Desafío</label>
        <textarea 
          rows="4" 
          placeholder="Cuéntanos brevemente sobre los objetivos, plazos estimados y visión..."
          required
          class="w-full bg-slate-900/80 border border-white/10 rounded-xl p-4 text-sm text-white focus:outline-none focus:border-cyan-400 transition-colors placeholder:text-slate-600 resize-none"
        ></textarea>
      </div>

      <button 
        type="submit" 
        class="w-full py-4 rounded-xl font-bold text-sm bg-gradient-to-r from-cyan-400 via-purple-500 to-rose-500 text-white shadow-lg shadow-purple-500/25 hover:shadow-cyan-500/35 transition-all duration-300 hover:opacity-95 active:scale-[0.99]"
      >
        Enviar Brief de Proyecto →
      </button>
    </form>
  </section>
</BaseLayout>
