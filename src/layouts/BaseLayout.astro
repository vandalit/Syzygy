---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Syzygy — Experiencia, Identidad y Contenido",
  description = "Agencia digital multidisciplinar enfocada en la alineación técnica y creativa de marcas: Experiencia Web (UX), Identidad (Branding) y Contenido (Marketing)."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://syzygy.metamedia.cl');
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts: Space Grotesk & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#07090e] text-slate-100 flex flex-col min-h-screen selection:bg-cyan-500/30 selection:text-cyan-200">
    <!-- Cosmic background glow -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
      <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-gradient-to-b from-cyan-600/10 via-purple-600/5 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-rose-600/5 blur-3xl rounded-full"></div>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-[#07090e]/80 border-b border-white/10 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Logo Syzygy -->
        <a href="/" class="group flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-purple-500 to-rose-500 p-[1px] transition-transform duration-300 group-hover:scale-105">
            <div class="w-full h-full bg-[#07090e] rounded-[11px] flex items-center justify-center">
              <span class="font-bold text-lg tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400 font-mono">
                SY
              </span>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-xl tracking-wider text-white uppercase font-['Space_Grotesk']">
              SYZYGY
            </span>
            <span class="text-[10px] tracking-widest text-slate-400 font-mono -mt-1">
              AGENCIA DIGITAL
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          <a href="#ejes" class="hover:text-cyan-400 transition-colors">Los 3 Ejes</a>
          <a href="#proyectos" class="hover:text-purple-400 transition-colors">Proyectos</a>
          <a href="#metodologia" class="hover:text-rose-400 transition-colors">Metodología</a>
          <a href="#manifiesto" class="hover:text-white transition-colors">Manifiesto</a>
        </nav>

        <!-- CTA & Status -->
        <div class="flex items-center gap-4">
          <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[11px] font-mono text-slate-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Astro SSG • Node v20
          </div>
          <a 
            href="#contacto" 
            class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-white text-slate-950 hover:bg-cyan-300 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/20 active:scale-95"
          >
            Iniciar Proyecto
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-white/10 bg-[#05070a] pt-16 pb-12 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          <!-- Columna Marca -->
          <div class="md:col-span-2 space-y-4">
            <div class="flex items-center gap-3">
              <span class="font-extrabold text-2xl tracking-wider text-white font-['Space_Grotesk']">
                SYZYGY
              </span>
              <span class="text-xs px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-mono">
                metamedia.cl
              </span>
            </div>
            <p class="text-slate-400 text-sm max-w-md leading-relaxed">
              Alineamos los tres cuerpos gravitacionales de una marca: Experiencia web con tecnología de vanguardia, Identidad visual con storytelling autoritario y Contenido multimedia estratégico.
            </p>
            <div class="text-xs text-slate-500 font-mono">
              Operando bajo modalidad de proyectos definidos • Sin planes recurrentes rígidos
            </div>
          </div>

          <!-- Columna Ejes -->
          <div class="space-y-3">
            <h5 class="text-xs font-mono uppercase tracking-widest text-slate-300">Ejes de Marca</h5>
            <ul class="space-y-2 text-sm text-slate-400">
              <li><span class="text-cyan-400">●</span> Experiencia (Web & UX)</li>
              <li><span class="text-purple-400">●</span> Identidad (Branding & Story)</li>
              <li><span class="text-rose-400">●</span> Contenido (Marketing & Media)</li>
            </ul>
          </div>

          <!-- Columna Arquitectura -->
          <div class="space-y-3">
            <h5 class="text-xs font-mono uppercase tracking-widest text-slate-300">Arquitectura Técnica</h5>
            <ul class="space-y-2 text-xs font-mono text-slate-400">
              <li>Frontend: Astro SSG</li>
              <li>Islas: React 19</li>
              <li>Backend: WordPress Headless (cPanel)</li>
              <li>Hosting: Oracle Cloud Always Free</li>
              <li>CI/CD: GitHub Actions</li>
            </ul>
          </div>
        </div>

        <div class="border-t border-white/5 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} Syzygy — Todos los derechos reservados. Desarrollado con código puro.</p>
          <div class="flex items-center gap-6">
            <a href="https://metamedia.cl" target="_blank" class="hover:text-slate-300 transition-colors">metamedia.cl</a>
            <span>•</span>
            <span class="text-emerald-400">● 100/100 Core Web Vitals Ready</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
